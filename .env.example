# Copy to .env.local and fill in real values. Never commit secrets.

# Google Maps JavaScript API (browser)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Required for Advanced Markers. Use DEMO_MAP_ID for local testing, or create a
# Map ID in Google Cloud → Map Management (Map type: JavaScript).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Supabase (browser-safe anon / publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Email/password Auth must be enabled in Supabase Dashboard → Authentication.
# Apply supabase/migrations/20261024200000_profiles_social.sql before using profiles.

# Data source: omit to auto-select (supabase when configured, else demo).
# NEXT_PUBLIC_DATA_SOURCE=demo

# ---------------------------------------------------------------------------
# Server-only — never prefix with NEXT_PUBLIC_ / never ship to the browser
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APIFY_API_TOKEN=your-apify-token
# Shared secret for POST /api/ingest/apify (Authorization: Bearer …)
# INGEST_SECRET=your-long-random-ingest-secret
#
# Near-realtime refresh when the app opens / location changes.
# Apify still takes tens of seconds — rate-limited per area (default 1 min).
# AUTO_INGEST_ON_OPEN=true
# AUTO_INGEST_MIN_INTERVAL_MINUTES=1
#
# FastAPI sklearn recommender (server-only). Start with:
#   cd services/recommender && source .venv/bin/activate && uvicorn app.main:app --port 8001
# RECOMMENDER_URL=http://127.0.0.1:8001
#
# Community post NL extraction + map NL search: no LLM provider is wired.
# POST /api/posts/extract and POST /api/nl-search use a labeled deterministic
# rules parser (not an LLM). Do not set fake OPENAI_* keys.
